#!/bin/sh
set -eu
# Wait for the developer-local origin at the tunnel listener. No request text,
# credential, response body or upstream error enters the journal.
attempt=0
while [ "$attempt" -lt 240 ]; do
    if python3 -c 'import socket; socket.create_connection(("127.0.0.1", 8081), timeout=2).close()'; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 1
done
exit 1
